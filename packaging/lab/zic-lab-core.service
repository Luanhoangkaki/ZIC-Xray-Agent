[Unit]
Description=ZIC isolated official Xray-core fixture
Requires=zic-lab-panel.service
After=zic-lab-panel.service
Before=zic-lab-agent.service

[Service]
Type=notify
NotifyAccess=all
TimeoutStartSec=60s
DynamicUser=yes
LoadCredential=xray.json:/opt/zic-xray-lab/config/xray.json
LoadCredential=lab.json:/opt/zic-xray-lab/config/lab.json
RuntimeDirectory=zic-lab-core
RuntimeDirectoryMode=0755
ExecStart=/bin/sh /opt/zic-xray-lab/start.sh core
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
Environment=GOMAXPROCS=1
MemoryMax=512M
TasksMax=128
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=60s
LogRateLimitBurst=5

[Install]
WantedBy=multi-user.target
